{
  "name": "@metricmind/server",
  "version": "0.2.0",
  "description": "MetricMind server-side helpers: server events, MCP tool-call analytics and AI crawler reads. No runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://metricmind.si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metricmind-si/metricmind.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/metricmind-si/metricmind/issues",
  "keywords": [
    "analytics",
    "mcp",
    "model-context-protocol",
    "ai-crawlers",
    "server-side-tracking",
    "metricmind"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./events": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./crawlers": {
      "types": "./dist/crawlers.d.ts",
      "default": "./dist/crawlers.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.10.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.1.12"
  }
}
